{
  "name": "ged-by-dz",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/setup-worker.mjs && prisma generate && next dev --hostname 127.0.0.1",
    "build": "node scripts/setup-worker.mjs && prisma generate && next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:import": "tsx scripts/import-legacy.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "postinstall": "node scripts/setup-worker.mjs",
    "test:e2e": "tsx scripts/verify-e2e.ts",
    "db:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-local-db.ps1",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.9",
    "jszip": "^3.10.2",
    "lucide-react": "^1.61.0",
    "next": "^16.4.3",
    "nodemailer": "^10.2.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sweetalert2": "^11.26.25",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
